rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInMember() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
          || (request.auth.token.firebase.sign_in_provider == 'custom'
            && request.auth.token.loginProvider in ['naver', 'kakao']));
    }

    // Aggregate counts are public; individual choices are private. Only the server writes.
    match /polls/{storyId} {
      allow read: if true;
      allow write: if false;
    }
    match /stories/{storyId}/votes/{userId} {
      allow get: if signedInMember() && request.auth.uid == userId;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow read: if signedInMember() && request.auth.uid == userId;

      allow create: if signedInMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'createdAt', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.nickname.matches('^[가-힣A-Za-z0-9_]+$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'createdAt', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.nickname.matches('^[가-힣A-Za-z0-9_]+$')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /stories/{storyId}/comments/{commentId} {
      allow read: if true;

      allow create: if signedInMember()
        && request.resource.data.keys().hasAll(['body', 'authorUid', 'authorNickname', 'createdAt'])
        && request.resource.data.keys().hasOnly(['body', 'authorUid', 'authorNickname', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorNickname is string
        && request.resource.data.authorNickname == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 300
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
